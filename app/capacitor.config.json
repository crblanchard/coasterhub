{
  "appId": "org.coasterhub.app",
  "appName": "Coaster Hub",
  "webDir": "www",
  "server": {
    "url": "https://coasterhub.org"
  },
  "appendUserAgent": "CoasterHubApp",
  "ios": {
    "contentInset": "never",
    "scheme": "Coaster Hub",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0b1020",
      "showSpinner": false
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
