{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coasterhub",
  "main": "worker.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Profile pictures. The Worker reads objects through this binding and serves
  // them itself at /avatars/<key> — the bucket is NOT public, so pictures live
  // on coasterhub.org and nobody can enumerate the bucket directly.
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "coasterhub-avatars"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coasterhub",
      "database_id": "d4742d82-f606-498a-8520-bcbfec7dcf91"
    }
  ]
}
